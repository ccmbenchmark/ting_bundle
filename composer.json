{
    "name": "ccmbenchmark/ting_bundle",
    "description" : "Symfony bundle for ccmbenchmark/ting. Provides an interface to use a lightweight datamapper in symfony.",
    "type": "symfony-bundle",
    "license": "Apache-2.0",
    "support": {
        "issues": "https://gitlab.ccmbg.com/core/ting_bundle/-/issues",
        "source": "https://gitlab.ccmbg.com/core/ting_bundle"
    },
    "repositories": {
        "gitlab.ccmbg.com/core": {
            "type": "composer",
            "url": "https://gitlab.ccmbg.com/api/v4/group/37/-/packages/composer/packages.json"
        }
    },
    "require": {
        "php": ">=8.1",
        "ccmbenchmark/ting": "^4.0",
        "doctrine/cache": "^1.10",
        "symfony/validator": "^4.4 || ^5.0 || ^6.0 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^4.4 || ^5.0 || ^6.0 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^4.4 || ^5.0 || ^6.0 || ^7.0 || ^8.0",
        "symfony/config": "^4.4 || ^5.0 || ^6.0 || ^7.0 || ^8.0",
        "symfony/stopwatch": "^4.4 || ^5.0 || ^6.0 || ^7.0 || ^8.0",
        "symfony/service-contracts": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "atoum/atoum": "^4.2",
        "atoum/stubs": "^2.2",
        "brick/geo": ">=0.5 <=1.0",
        "symfony/expression-language": "^6.3 || ^7.2 || ^8.0",
        "symfony/serializer": "^6.0 || ^7.0 || ^8.0",
        "symfony/security-bundle": "^6.0 || ^7.0 || ^8.0",
        "symfony/security-core": "^6.0 || ^7.0 || ^8.0",
        "symfony/uid": "^6.0 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4" : {
            "CCMBenchmark\\TingBundle\\": "src/TingBundle/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\fixtures\\": "tests/fixtures/"
        }
    },
    "minimum-stability" : "stable"
}
